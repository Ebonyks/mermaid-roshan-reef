{
  "schema": "location-geometry-lock-v1",
  "purpose": "Fail closed when a cinematic first frame invents, removes, merges, or reorders location geometry.",
  "location_id": "<stable location id>",
  "camera_family": "<orthographic side elevation, approved reverse, approved three-quarter, etc.>",
