    {
      "path": "<packet-relative approved source image>",
      "sha256": "<64 lowercase hex>",
      "dimensions": [1280, 720],
      "appearance_role": "location_topology_authority"
    }
  ],
  "ordered_landmarks_left_to_right": [
    {
      "landmark_id": "<stable id>",
      "kind": "<portal, column, window, fixture, stair, etc.>",
      "required": true,
      "normalized_x_range": [0.0, 1.0],
      "notes": "<identity and adjacency constraints>"
    }
  ],
  "global_invariants": [
    "Do not combine two location masters into an invented third space.",
    "A portal opening must remain open to the floor unless the authority shows a sill.",
    "Absent stairs, balconies, doors, windows, and fixtures are forbidden additions."
  ],
  "candidate_reviews": [
    {
      "shot_id": "<shot id>",
      "path": "<packet-relative first-frame candidate>",
      "sha256": "<64 lowercase hex>",
      "authority_source_ids": ["<source id>"],
      "landmark_order_decision": "pending",
      "portal_floor_openings_decision": "pending",
      "fixture_count_decision": "pending",
      "forbidden_additions_decision": "pending",
      "human_decision": "pending",
      "eligible_as_image_1": false
    }
  ]
}
