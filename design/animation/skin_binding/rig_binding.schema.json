{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mermaid-roshan.invalid/skin-binding/rig-1",
  "$comment": "Proposed source-authoring interchange v1. The stdlib/Pillow CLI adds hash, geometry and compatibility checks; no runtime or artistic acceptance is implied.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "roshan.rig-binding/1"
    },
    "rig_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "prototype",
        "approved"
      ]
    },
    "skeleton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^:\\\\]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "bones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "views": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "canvas": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "slots": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "required": {
                  "type": "boolean"
                },
                "modes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "rigid",
                      "weighted"
                    ]
                  }
                },
                "layer": {
                  "type": "integer"
                }
              },
              "required": [
                "required",
                "modes",
                "layer"
              ]
            }
          }
        },
        "required": [
          "canvas",
          "slots"
        ]
      }
    },
    "sockets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bone": {
            "type": "string"
          },
          "offset": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "bone",
          "offset"
        ]
      }
    },
    "identity_assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^:\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^:\\\\]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "interfaces": {
      "type": "object"
    }
  },
  "required": [
    "format",
    "rig_id",
    "version",
    "status",
    "skeleton",
    "bones",
    "views",
    "sockets",
    "identity_assets",
    "templates"
  ]
}
