{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mermaid-roshan.invalid/skin-binding/mesh-1",
  "$comment": "Proposed source-authoring interchange v1. The stdlib/Pillow CLI adds hash, geometry and compatibility checks; no runtime or artistic acceptance is implied.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "roshan.attachment-mesh/1"
    },
    "space": {
      "const": "canonical_canvas_px"
    },
    "vertices": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    },
    "uv": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "number"
        }
      }
    },
    "triangles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "weights": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "seams": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "format",
    "space",
    "vertices",
    "uv",
    "triangles",
    "weights"
  ]
}
