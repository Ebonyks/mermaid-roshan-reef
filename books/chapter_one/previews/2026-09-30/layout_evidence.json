  "text_lines": [
    {
      "page": "S06",
      "text": "Round and round went the sponge.",
      "font": "Sniglet",
      "size": 18,
      "box": [
        114.71399999999997,
        312.798,
        274.57200000000006,
        22.409999999999997
      ]
    },
    {
      "page": "S06",
      "text": "Roshan wiped the sink clean.",
      "font": "Sniglet",
      "size": 18,
      "box": [
        139.08599999999998,
        289.398,
        225.82800000000003,
        22.409999999999997
      ]
    },
    {
      "page": "S08",
      "text": "Clean water filled the bath.",
      "font": "Sniglet",
      "size": 18,
      "box": [
        146.313,
        49.798,
        211.37400000000002,
        22.409999999999997
      ]
    },
    {
      "page": "S08",
      "text": "The dust bunny splashed again!",
      "font": "Sniglet",
      "size": 18,
      "box": [
        127.16099999999999,
        26.397999999999996,
        249.67800000000003,
        22.409999999999997
      ]
    },
    {
      "page": "S13",
      "text": "Roshan pulled the cup free!",
      "font": "Sniglet",
      "size": 18,
      "box": [
        207,
        314.798,
        213.87600000000003,
        22.409999999999997
      ]
    },
    {
      "page": "S15",
      "text": "“You helped me!”",
      "font": "Sniglet",
      "size": 18,
      "box": [
        40,
        257.798,
        134.02800000000002,
        22.409999999999997
      ]
    },
    {
      "page": "S15",
      "text": "said Rumi.",
      "font": "Sniglet",
      "size": 18,
      "box": [
        40,
        234.398,
        79.632,
        22.409999999999997
      ]
    },
    {
      "page": "S15",
      "text": "She gave Roshan",
      "font": "Sniglet",
      "size": 18,
      "box": [
        40,
        210.998,
        135.46800000000002,
        22.409999999999997
      ]
    },
    {
      "page": "S15",
      "text": "a great big hug.",
      "font": "Sniglet",
      "size": 18,
      "box": [
        40,
        187.59799999999998,
        123.01200000000001,
        22.409999999999997
      ]
    },
    {
      "page": "S18",
      "text": "“I’ll help!” said Roshan.",
      "font": "Sniglet",
      "size": 18,
      "box": [
        165.834,
        52.798,
        172.33200000000002,
        22.409999999999997
      ]
    },
    {
      "page": "S18",
      "text": "She brushed one bunny away, then the other.",
      "font": "Sniglet",
      "size": 18,
      "box": [
        73.43099999999998,
        29.397999999999996,
        357.13800000000003,
        22.409999999999997
      ]
    },
    {
      "page": "S19",
      "text": "Baby Eagle was free!",
      "font": "Sniglet",
      "size": 22,
      "box": [
        152.549,
        311.642,
        198.902,
        27.39
      ]
    },
    {
      "page": "S19",
      "text": "Now they could play gently.",
      "font": "Sniglet",
      "size": 18,
      "box": [
        144.117,
        277.798,
        215.76600000000002,
        22.409999999999997
      ]
    },
    {
      "page": "S19",
      "text": "Sorry!",
      "font": "Sniglet",
      "size": 18,
      "box": [
        83.731,
        176.79500000000002,
        47.538000000000004,
        22.409999999999997
      ]
    },
    {
      "page": "S19",
      "text": "We were just",
      "font": "Sniglet",
      "size": 18,
      "box": [
        350.608,
        197.995,
        98.784,
        22.409999999999997
      ]
    },
    {
      "page": "S19",
      "text": "playing!",
      "font": "Sniglet",
      "size": 18,
      "box": [
        368.788,
        174.595,
        62.42400000000001,
        22.409999999999997
      ]
    },
    {
      "page": "S23",
      "text": "“Purple sparkles!”",
      "font": "Sniglet",
      "size": 18,
      "box": [
        260,
        314.798,
        139.032,
        22.409999999999997
      ]
    },
    {
      "page": "S23",
      "text": "said Roshan.",
      "font": "Sniglet",
      "size": 18,
      "box": [
        260,
        291.398,
        98.65800000000002,
        22.409999999999997
      ]
    },
    {
      "page": "S26",
      "text": "Sparkles flew from Roshan’s shell.",
      "font": "Sniglet",
      "size": 18,
      "box": [
        120.29399999999998,
        311.798,
        263.41200000000003,
        22.409999999999997
      ]
    },
    {
      "page": "S26",
      "text": "Grand Puff wobbled. “Easy, Grand Puff!”",
      "font": "Sniglet",
      "size": 18,
      "box": [
        98.93699999999998,
        288.398,
        306.12600000000003,
        22.409999999999997
      ]
    },
    {
      "page": "S27",
      "text": "Daddy, Rumi, and Baby Eagle helped Roshan.",
      "font": "Sniglet",
      "size": 18,
      "box": [
        76.32899999999998,
        312.798,
        351.34200000000004,
        22.409999999999997
      ]
    },
    {
      "page": "S27",
      "text": "“Let’s help Grand Puff!” Scrub, scrub!",
      "font": "Sniglet",
      "size": 18,
      "box": [
        110.41199999999998,
        289.398,
        283.17600000000004,
        22.409999999999997
      ]
    },
    {
      "page": "S31",
      "text": "“Your rainbow was there all along,",
      "font": "Sniglet",
      "size": 18,
      "box": [
        118.39499999999998,
        310.798,
        267.21000000000004,
        22.409999999999997
      ]
    },
    {
      "page": "S31",
      "text": "Grand Puff. We helped it shine!”",
      "font": "Sniglet",
      "size": 18,
      "box": [
        130.986,
        287.398,
        242.02800000000002,
        22.409999999999997
      ]
    }
  ],
