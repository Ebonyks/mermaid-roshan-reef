  "text_lines": [
    {
      "page": "front_cover",
      "text": "Mermaid Roshan",
      "box": [
        200.15,
        303.33,
        221.7,
        37.35
      ],
      "font_size": 30,
      "color": "navy"
    },
    {
      "page": "front_cover",
      "text": "and the Hidden Rainbow",
      "box": [
        193.79500000000002,
        275.642,
        234.41,
        27.39
      ],
      "font_size": 22,
      "color": "navy"
    },
    {
      "page": "front_cover",
      "text": "A Pearl Castle friendship story",
      "box": [
        166.213,
        24.243,
        171.574,
        16.185
      ],
      "font_size": 13,
      "color": "navy"
    },
    {
      "page": 1,
      "text": "“Look, Daddy!",
      "box": [
        278,
        70.798,
        106.29,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 1,
      "text": "Pearl Castle!”",
      "box": [
        278,
        47.397999999999996,
        105.33600000000001,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 2,
      "text": "Roshan and Daddy landed at Sky Lagoon.",
      "box": [
        28,
        312.798,
        326.16,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 2,
      "text": "Pearl Castle was close by.",
      "box": [
        28,
        289.398,
        201.40200000000002,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 3,
      "text": "Inside, dust covered the floor.",
      "box": [
        205,
        312.798,
        230.14800000000002,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 3,
      "text": "“Let’s clean it together!”",
      "box": [
        205,
        289.398,
        188.64000000000001,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 4,
      "text": "Daddy gave her a brush and a sponge.",
      "box": [
        101.60999999999999,
        310.798,
        300.78000000000003,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 4,
      "text": "“One little job at a time.”",
      "box": [
        156.024,
        287.398,
        191.95200000000003,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 5,
      "text": "A dust bunny splashed in the dirty bath.",
      "box": [
        95.57099999999997,
        52.798,
        312.85800000000006,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 5,
      "text": "It loved to play. Splash, splash!",
      "box": [
        132.10199999999998,
        29.397999999999996,
        239.79600000000002,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 6,
      "text": "Round and round",
      "box": [
        278,
        244.798,
        135.39600000000002,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 6,
      "text": "went the sponge.",
      "box": [
        278,
        221.398,
        135.41400000000002,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 6,
      "text": "Roshan wiped",
      "box": [
        278,
        197.998,
        110.01600000000002,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 6,
      "text": "the sink clean.",
      "box": [
        278,
        174.59799999999998,
        112.05000000000001,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 7,
      "text": "Roshan let the dirty bath water out.",
      "box": [
        111.303,
        310.798,
        281.394,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 7,
      "text": "Then she scrubbed the tub. Scrub, scrub!",
      "box": [
        91.92599999999999,
        287.398,
        320.148,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 8,
      "text": "Clean water filled the bath.",
      "box": [
        146.313,
        49.798,
        211.37400000000002,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 8,
      "text": "The playful pest splashed again!",
      "box": [
        125.20799999999998,
        26.397999999999996,
        253.58400000000003,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 9,
      "text": "A mermaid named Rumi was stuck",
      "box": [
        115.33499999999998,
        49.798,
        273.33000000000004,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 9,
      "text": "under the gunk in the pool.",
      "box": [
        146.988,
        26.397999999999996,
        210.02400000000003,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 10,
      "text": "This castle had been Rumi’s home",
      "box": [
        118.79999999999998,
        310.798,
        266.40000000000003,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 10,
      "text": "for hundreds of years.",
      "box": [
        166.47299999999998,
        287.398,
        171.05400000000003,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 10,
      "text": "“I’ll help!” said Roshan. Scoop, scoop!",
      "box": [
        109.30499999999998,
        263.99800000000005,
        285.39000000000004,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 11,
      "text": "One stream ran clear.",
      "box": [
        166.43699999999998,
        52.798,
        171.12600000000003,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 11,
      "text": "Roshan cleared the next... and the next.",
      "box": [
        97.60499999999999,
        29.397999999999996,
        308.79,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 12,
      "text": "All three streams were clear.",
      "box": [
        139.644,
        52.798,
        224.71200000000002,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 12,
      "text": "Whoosh! The waterfall turned rainbow!",
      "box": [
        100.43999999999997,
        29.397999999999996,
        303.12000000000006,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 13,
      "text": "Roshan cleared the fountain!",
      "box": [
        213,
        311.798,
        227.52000000000004,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 14,
      "text": "Fresh water flowed. The gunk was gone.",
      "box": [
        96.40799999999999,
        49.798,
        311.184,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 14,
      "text": "Up came Rumi. She was free!",
      "box": [
        139.509,
        26.397999999999996,
        224.98200000000003,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 15,
      "text": "“You helped me!” said Rumi.",
      "box": [
        143.289,
        52.798,
        217.42200000000003,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 15,
      "text": "She gave Roshan a great big hug.",
      "box": [
        120.87899999999999,
        29.397999999999996,
        262.242,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 16,
      "text": "Chirp, chirp!",
      "box": [
        205.272,
        52.798,
        93.45600000000002,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 16,
      "text": "“Someone needs help!” said Roshan.",
      "box": [
        109.66499999999999,
        29.397999999999996,
        284.67,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 17,
      "text": "Two dust bunnies had tumbled onto Baby Eagle.",
      "box": [
        62.14499999999998,
        52.798,
        379.71000000000004,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 17,
      "text": "They wanted to play, but he was stuck.",
      "box": [
        99.67499999999998,
        29.397999999999996,
        304.65000000000003,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 18,
