  "text_lines": [
    {
      "page": "front_cover",
      "text": "Mermaid Roshan",
      "box": [
        200.15,
        303.33,
        221.7,
        37.35
      ],
      "font_size": 30,
      "color": "navy"
    },
    {
      "page": "front_cover",
      "text": "and the Hidden Rainbow",
      "box": [
        193.79500000000002,
        275.642,
        234.41,
        27.39
      ],
      "font_size": 22,
      "color": "navy"
    },
    {
      "page": "front_cover",
      "text": "A Pearl Castle friendship story",
      "box": [
        166.213,
        24.243,
        171.574,
        16.185
      ],
      "font_size": 13,
      "color": "navy"
    },
    {
      "page": 1,
      "text": "\u201cLook, Daddy!",
      "box": [
        278,
        70.798,
        106.29,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 1,
      "text": "Pearl Castle!\u201d",
      "box": [
        278,
        47.397999999999996,
        105.33600000000001,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 2,
      "text": "They landed at Sky Lagoon.",
      "box": [
        28,
        312.798,
        216.66600000000003,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 2,
      "text": "Together, they went to Pearl Castle.",
      "box": [
        28,
        289.398,
        282.00600000000003,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 3,
      "text": "Inside Pearl Castle,",
      "box": [
        205,
        312.798,
        148.30200000000002,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 3,
      "text": "dust covered the floor!",
      "box": [
        205,
        289.398,
        177.85800000000003,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 3,
      "text": "\u201cLet\u2019s clean it together!\u201d",
      "box": [
        205,
        265.99800000000005,
        188.64000000000001,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 4,
      "text": "\u201cOne little job at a time,\u201d said Daddy.",
      "box": [
        108.78299999999999,
        310.798,
        286.434,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 4,
      "text": "He gave Roshan a brush and a sponge.",
      "box": [
        100.47599999999997,
        287.398,
        303.04800000000006,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 5,
      "text": "First, Roshan drained the murky bath.",
      "box": [
        103.392,
        28.798000000000002,
        297.216,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 6,
      "text": "Round and round",
      "box": [
        278,
        244.798,
        135.39600000000002,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 6,
      "text": "went the sponge.",
      "box": [
        278,
        221.398,
        135.41400000000002,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 6,
      "text": "Roshan wiped",
      "box": [
        278,
        197.998,
        110.01600000000002,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 6,
      "text": "the sink clean.",
      "box": [
        278,
        174.59799999999998,
        112.05000000000001,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 7,
      "text": "Back and forth. Scrub, scrub!",
      "box": [
        139.392,
        310.798,
        225.21600000000004,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 7,
      "text": "Roshan brushed the empty tub clean.",
      "box": [
        103.99499999999998,
        287.398,
        296.01000000000005,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 8,
      "text": "Clean water sparkled in the bath.",
      "box": [
        121.34699999999998,
        49.798,
        261.30600000000004,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 8,
      "text": "The little bunny splashed happily.",
      "box": [
        120.267,
        26.397999999999996,
        263.466,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 9,
      "text": "The great pool was still murky.",
      "box": [
        131.94,
        49.798,
        240.12000000000003,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 9,
      "text": "Its rainbow waterfall had stopped.",
      "box": [
        117.16199999999998,
        26.397999999999996,
        269.67600000000004,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 10,
      "text": "Scoop, lift, and out it came!",
      "box": [
        145.305,
        310.798,
        213.39000000000001,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 10,
      "text": "Roshan gathered the floating rubbish.",
      "box": [
        102.57299999999998,
        287.398,
        298.85400000000004,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 11,
      "text": "One lane clear! Two more to go.",
      "box": [
        128.08799999999997,
        28.798000000000002,
        247.82400000000004,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 12,
      "text": "Whoooosh! The waterfall turned rainbow!",
      "box": [
        90.28799999999998,
        28.798000000000002,
        323.42400000000004,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 13,
      "text": "Roshan pulled the rubbish free!",
      "box": [
        213,
        311.798,
        244.72800000000004,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 14,
      "text": "The fountain flowed again.",
      "box": [
        148.41899999999998,
        49.798,
        207.16200000000003,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 14,
      "text": "Fresh water swirled. The pool was clear!",
      "box": [
        96.30899999999997,
        26.397999999999996,
        311.38200000000006,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 15,
      "text": "\u201cThank you for helping!\u201d said Rumi.",
      "box": [
        116.49599999999998,
        28.798000000000002,
        271.00800000000004,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 16,
      "text": "A tiny chirp! \u201cSomeone needs help!\u201d",
      "box": [
        112.374,
        28.798000000000002,
        279.252,
        22.41
      ],
      "font_size": 18,
      "color": "white"
    },
    {
      "page": 17,
      "text": "Two dust bunnies trapped Baby Eagle. \u201cI\u2019ll help!\u201d",
      "box": [
        64.05299999999997,
        26.298000000000002,
        375.89400000000006,
        22.41
      ],
      "font_size": 18,
      "color": "navy"
    },
    {
      "page": 18,
      "text": "One bunny, then the other. Little by little...",
      "box": [
        88.79399999999998,
        26.298000000000002,
        326.41200000000003,
        22.41
