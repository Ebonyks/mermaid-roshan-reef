{
  "_comment": [
    "Declarative spec for tools/audit_visual_design.py — the game-wide visual",
    "design audit. THIS FILE IS THE EXPANSION SURFACE: adding a surface, changing",
    "a budget, or recording a complete owner-approved waiver is a JSON edit, not a",
    "code edit. Adding a new KIND of check is a Python edit (see",
    "VISUAL_AUDIT_TOOL.md).",
    "",
    "Every budget below traces to a stable rule in the comprehensive design",
    "language. The final 2026-08-09 owner decision makes Roshan 2D-only;",
    "Sprite3D is staging for flat art, not permission for a modelled character."
  ],
  "version": 3,

  "rules": {
    "texture_max_side_or_pot": "DL-PERF-04: new textures are <=1024px longest side or power-of-two",
    "mural_layer_stack": "DL-LAY-02: a panning promenade uses at least two independently staged background layers",
    "layering_rule": "DL-LAY-01/DL-LAY-03/DL-LAY-04/DL-LAY-08: named depth roles, owned interaction cards, per-card occlusion, sparse foreground",
    "background_recessive": "DL-READ-01/DL-READ-02: backgrounds frame play and interactive silhouettes remain identifiable at phone size",
    "alpha_layer_budget": "DL-PERF-03: transparent overdraw stays inside the Speedy-tier budget",
    "tap_target_size": "DL-UI-03: required child-facing touch targets should be at least 110x110 base-canvas pixels",
    "probe_gate": "DL-QA-02/DL-QA-07: active shipped surfaces have automated evidence and missing coverage never becomes pass",
    "licenses": "DL-ASSET-04: every new asset gets an ASSET_LICENSES.md entry in the same commit",
    "no_text_in_art": "DL-AGE-08/DL-READ-04: no scary imagery and no reading-dependent words, letters, or digits in world art",
    "standee_not_mural": "DL-LAY-03: anything Roshan can tap, approach, pass, or stand behind is an independent owned card",
    "orphan_art": "DL-PERF-06: superseded runtime art leaves export after references and provenance are resolved",
    "asset_generations": "DL-ASSET-05: rejected generations and review material stay outside runtime assets",
    "waiver_contract": "DL-QA-08: a waiver names exact scope, reason, owner, date, review trigger, and residual child risk"
  },

  "budgets": {
    "texture_max_side": 1024,
    "zone_runtime_texture_mb": 24.0,
    "mural_min_layers": 2,
    "mural_min_lock_spread": 0.3,
    "world_card_min_depth_spread": 2.0,
    "standee_alpha_coverage_min": 0.05,
    "standee_alpha_coverage_max": 0.90,
    "alpha_layers_max": 2,
    "background_saturation_ratio_max": 0.90,
    "foreground_luminance_delta_min": 0.04,
    "orphan_bytes_warn": 1048576
  },

