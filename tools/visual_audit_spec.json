{
  "_comment": [
    "Declarative spec for tools/audit_visual_design.py — the game-wide visual",
    "design audit. THIS FILE IS THE EXPANSION SURFACE: adding a zone, changing",
    "a budget, or silencing a known-and-accepted finding is a JSON edit, not a",
    "code edit. Adding a new KIND of check is a Python edit (see",
    "VISUAL_AUDIT_TOOL.md).",
    "",
    "Every budget below traces to a written rule. The 'rule' field on each",
    "budget names the document it comes from so a disagreement is settled",
    "against the charter, not against the tool."
  ],
  "version": 2,

  "rules": {
    "texture_max_side_or_pot": "CLAUDE.md: all new textures <=1024px longest side OR power-of-two",
    "mural_layer_stack": "GAME_REDESIGN_2P5D_2026-07-27 §1: a promenade is a parallax flat stack of 4-5 layers, not one painting",
    "layering_rule": "GAME_REDESIGN_2P5D_2026-07-27 §1 'The layering rule': background murals behind the band, standees at real depth INSIDE or around the band, foreground occluders in front",
    "background_recessive": "CODEX_BACKGROUND_FLATS_WORKORDER_2026-07-27 'Contrast rule': the play plane stays LOW detail and LOW saturation relative to characters and tap targets",
    "alpha_layer_budget": "CODEX_BACKGROUND_FLATS_WORKORDER_2026-07-27 'Overdraw budget (Mali GPU, hard)': at most TWO alpha layers per stage",
    "reversibility": "GAME_REDESIGN_2P5D_2026-07-27 §3 P2: the new world ships behind an additive save key, classic default until sign-off",
    "pilot_first": "GAME_REDESIGN_2P5D_2026-07-27 §2: zone migration order, reef promenade is the pilot that proves the rig",
    "licenses": "CLAUDE.md: every new asset gets a line in ASSET_LICENSES.md in the same commit",
    "no_text_in_art": "CODEX_BACKGROUND_FLATS_WORKORDER_2026-07-27 'House rules': no words, letters or digits anywhere in a flat",
    "standee_not_mural": "CODEX_BACKGROUND_FLATS_WORKORDER_2026-07-27: anything Roshan can tap, pass, or stand behind ships as its own sprite with its own depth"
  },

  "budgets": {
    "texture_max_side": 1024,
    "zone_runtime_texture_mb": 24.0,
    "mural_min_layers": 2,
    "mural_min_lock_spread": 0.3,
    "world_card_min_depth_spread": 2.0,
    "standee_alpha_coverage_min": 0.05,
    "standee_alpha_coverage_max": 0.90,
    "alpha_layers_max": 2,
    "background_saturation_ratio_max": 0.90,
    "foreground_luminance_delta_min": 0.04,
    "orphan_bytes_warn": 1048576
  },

