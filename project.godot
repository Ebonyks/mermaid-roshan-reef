; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Mermaid Roshan Reef of Light"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[audio]

; MAGIC WORDS (scripts/voice_spells.gd): shouting "FREEZE" casts a spell, so
; the audio driver must be allowed to open an input device. Nothing records or
; leaves the phone — the mic bus is muted, the samples are read as a loudness
; envelope in memory and dropped. The stream is only ever STARTED after a
; grown-up turns Magic Words on in the pause menu, so no permission dialog and
; no mic indicator appears for families that never switch it on.
driver/enable_input=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[filesystem]

import/blender/enabled=false
import/fbx/importer=0

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true

[shader_globals]

wind_dir={
"type": "vec3",
"value": Vector3(0.85, 0, 0.53)
}
wind_gust={
"type": "float",
"value": 0.6
}
