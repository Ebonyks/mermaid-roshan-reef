    "named": {
      "ODR-FASHION-PERSISTENCE-20261006": {
        "date": "2026-10-06",
        "decision": "The cosmetic feature redresses recurring characters across the game with persistent effects, includes unlockable outfits throughout play, and teaches later disguise through dress-up games. This supersedes the initial working assumption that all clothes are freely available."
      },
      "ODR-POPSTAR-SONG-20261018": {
        "date": "2026-10-18",
        "decision": "Use a new concert arrangement of the existing Starlight Singalong first; use Iko Iko for the Day Two story only once its game-use rights are confirmed."
      },
      "ODR-RUMI-REVISION-HANDOFF-20261017": {
        "date": "2026-10-17",
        "decision": "Owner: the book \"needs significant plot revisions, and developments to be able to integrate smoothly into the game environment\"; \"Focus on producing rich, robust undersea world, the inspirations are clearly in the comics, but they appear narrow, and a bathhouse scene is not truly developed. Also, not nearly enough plotting to hold together such a long book.\" Analyse traditional comics for pacing and style and draft solutions as a Codex handoff. Commissions analysis and a written handoff; accepts no story, art or runtime change and commissions no playable chapter."
      },
      "ODR-PRIORITY-JOB-TAKEOVER": {
        "date": "2026-09-30",
        "decision": "Job-game takeover readiness (MA-DOC-006) is critical to the owner and comes first in development planning; it does not reorder the child-facing defect repairs."
      },
      "ODR-LEARNING-SCOPE-20261018": null
    },
