        "242: \tsetup()",
        "243: \tvar spec: Dictionary = m.living_specs[stage_id]",
        "244: \tm.living_stage_id = stage_id",
        "245: \tm.living_time = 0.0",
        "246: \tm.living_idle_time = 0.0",
        "247: \tm.living_cooldown = 0.0",
        "248: \tm.living_event_time = -1.0",
        "249: \tm.living_generation += 1",
        "250: \tvar canvas_layer: int = int(spec[\"canvas_layer\"])",
        "251: \t# Sky's opaque world is layer -1, the ordinary HUD stays at 0, and these",
        "252: \t# quiet accents occupy 6. Speech/touch/pause/fade remain above at 8/9/12/30.",
        "253: \t# Assert the shared contract at runtime rather than letting catalog drift put",
        "254: \t# an ambient card underneath the stage or above child-facing controls.",
        "255: \tif String(spec.get(\"group\", \"\")) == \"sky_promenade\":",
        "256: \t\tcanvas_layer = m.SKY_LAGOON_LIVING_CANVAS_LAYER",
