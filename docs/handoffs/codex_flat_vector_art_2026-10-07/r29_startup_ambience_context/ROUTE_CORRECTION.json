        "54: \tvar root := Control.new()",
        "55: \troot.name = \"StartMenuRoot\"",
        "56: \troot.set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)",
        "57: \tm.start_menu_layer.add_child(root)",
        "58: ",
        "59: \tvar background := ColorRect.new()",
