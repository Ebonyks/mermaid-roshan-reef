        "74: func tick(delta: float) -> void:",
        "75: \tsetup()",
        "76: \t# A headless probe-stage override is an explicit isolated runtime request.",
        "77: \t# Do not let a still-fading boot/castle cover make every forced idle event a",
        "78: \t# zero-event no-op on unusually fast CI runners. Production has no override.",
        "79: \tvar probe_stage_active: bool = DisplayServer.get_name() == \"headless\" \\",
        "80: \t\tand m.living_probe_stage_override != \"\"",
        "81: \tif _suspended() and not probe_stage_active:",
        "82: \t\tnote_activity()",
        "83: \t\tm.living_layer.visible = false",
        "84: \t\treturn",
        "85: \tvar next_stage: String = resolve_stage_id()",
        "86: \tif next_stage == \"\" or not m.living_specs.has(next_stage):",
        "87: \t\tdeactivate()",
        "88: \t\treturn",
        "89: \tif next_stage != m.living_stage_id:",
        "90: \t\t_switch_stage(next_stage)",
        "91: \tif _held_input_active():",
        "92: \t\tnote_activity()",
        "93: \telse:",
        "94: \t\tm.living_idle_time += delta",
        "95: \tm.living_time = fmod(m.living_time + delta, 3600.0)",
        "96: \tm.living_cooldown = maxf(0.0, m.living_cooldown - delta)",
        "97: \tvar spec: Dictionary = m.living_specs[m.living_stage_id]",
        "98: \tvar idle: Dictionary = spec[\"idle_event\"]",
        "99: \tvar event_progress := -1.0",
        "100: \tif m.living_event_time >= 0.0:",
        "101: \t\tm.living_event_time += delta",
        "102: \t\tvar duration: float = float(idle[\"duration\"])",
        "103: \t\tif m.living_event_time >= duration:",
        "104: \t\t\tm.living_event_time = -1.0",
        "105: \t\t\tm.living_idle_time = 0.0",
        "106: \t\telse:",
        "107: \t\t\tevent_progress = m.living_event_time / duration",
        "108: \telif m.living_idle_time >= float(idle[\"delay\"]) and m.living_cooldown <= 0.0:",
        "109: \t\tm.living_event_time = 0.0",
        "110: \t\tm.living_cooldown = float(idle[\"cooldown\"])",
        "111: \t\tm.living_event_count += 1",
        "112: \t\tevent_progress = 0.0",
        "113: \tm.living_layer.visible = true",
        "114: \tm.living_canvas.set_motion(m.living_time, event_progress)"
      ]
    },
