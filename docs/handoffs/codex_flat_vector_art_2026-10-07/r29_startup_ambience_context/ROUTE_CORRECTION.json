        "36: func build() -> void:",
        "37: \t# SceneTree.root survives reload_current_scene(), unlike the ReefMain node.",
        "38: \t# This one-shot marker therefore routes a freshly installed save straight",
        "39: \t# into Day 1 without flashing or rebuilding the menu a second time.",
        "40: \tvar scene_root: Window = m.get_tree().root",
        "41: \tif bool(scene_root.get_meta(DAY_ONE_AFTER_RESET_META, false)):",
        "42: \t\tscene_root.remove_meta(DAY_ONE_AFTER_RESET_META)",
        "43: \t\tm._launch_from_start_menu(true)",
        "44: \t\treturn",
        "45: \tm.start_menu_active = true",
        "46: \t# Existing gameplay and touch guards already treat the story intro as an",
        "47: \t# input-blocking surface. Reuse that contract while the launch menu is up.",
        "48: \tm.intro_active = true",
        "49: \tm.start_menu_layer = CanvasLayer.new()",
        "50: \tm.start_menu_layer.name = \"StartMenu\"",
        "51: \tm.start_menu_layer.layer = 20",
