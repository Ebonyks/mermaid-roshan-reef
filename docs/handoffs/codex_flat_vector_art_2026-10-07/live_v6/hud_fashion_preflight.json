  "source_observations": [
    {
      "id": "FASHION_CURRENT_ROSTER",
      "fact": "FashionWardrobe._build loops FashionParts.PEOPLE (three IDs); older five-character CHARACTERS/save/render roster is distinct."
    },
    {
      "id": "FASHION_SURFACES",
      "fact": "Normal/hover/pressed/focus states are existing painted StyleBoxTexture; inherited disabled flat style needs reachability review; no button disabled assignment exists in this builder."
    },
    {
      "id": "FASHION_GLYPHS",
      "fact": "Source uses lock/check/triangular arrows/down-finger for pictured UI art; PNG garment/card art is only a provisional style/reuse candidate."
    },
    {
      "id": "FASHION_BURST",
      "fact": "Each actual burst constructs fourteen flat Polygon2D eight-point sparkles; repeated bursts cancel prior tween and remove prior burst. Transient occurrence total is unbounded."
    },
    {
      "id": "HUD_OBJECTIVE",
      "fact": "Objective card is a flat StorybookUI frame with painted TextureRect or label fallback, plus three sparkle emoji. Current production _set_objective call sites pass empty emoji; fallback source capability is not current visible glyph proof."
    },
    {
      "id": "HUD_HIDDEN",
      "fact": "HudStatusTray and pearl/star labels are initialized hidden; full caller/property review and native proof remain separate."
    },
    {
      "id": "HUD_SAVE",
      "fact": "SaveState has warnings/errors and persistent state APIs but no dedicated child save toast/panel found in its exact source. The broad ui.save_hud coverage entry should retain HUD/context and failed-write gaps, not invent a save popup."
    },
    {
      "id": "FADE_FUNCTIONAL",
      "fact": "One uniform black full-viewport ColorRect at CanvasLayer30 covers synchronous rebuilds and blocks input, then reveals over0.25s. Functional classification requires actual endpoint/context proof; no scope is newly closed by this source preflight."
    },
    {
      "id": "FASHION_INHERITED_HOVER_PRESSED",
      "fact": "StorybookUI.style_picture_button creates a StyleBoxFlat hover_pressed override. FashionWardrobe._button replaces only normal/hover/pressed/focus with painted textures, leaving hover_pressed and disabled flat. The rerun now records both actual draw state and hover_pressed style; visible context proof pending."
    }
  ],
