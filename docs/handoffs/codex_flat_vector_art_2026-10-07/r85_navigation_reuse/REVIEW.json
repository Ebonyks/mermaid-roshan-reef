  "axes": [
    {
      "axis": "contour",
      "observation": "The original near-circle becomes a softly rounded painted frame with four gold corner details. At the unchanged112px target it remains separated from scenery, but this is a deliberate material silhouette change and new-use acceptance remains open.",
      "disposition": "PARTIAL_REUSE_SAMPLE_NEW_USE_AND_ACCEPTANCE_OPEN"
    },
    {
      "axis": "material",
      "observation": "Parchment grain, broad violet edge bands and gold highlights replace the uniform mathematical fill in the ignored sample. The existing full source is nine-sliced after only outside alpha<=1 padding is omitted; no source pixels were repainted.",
      "disposition": "PARTIAL_REUSE_SAMPLE_NEW_USE_AND_ACCEPTANCE_OPEN"
    },
    {
      "axis": "palette",
      "observation": "Untinted normal uses the source cream/violet/gold and relates to castle roofs, walls and bridge trim. Hover/pressed/focus/disabled UI modulation is explicitly declared, not byte-identical framebuffer or approved source-color acceptance. Characters/environment are unchanged.",
      "disposition": "PARTIAL_REUSE_SAMPLE_NEW_USE_AND_ACCEPTANCE_OPEN"
    },
    {
      "axis": "light",
      "observation": "Authored frame highlights remain stable with no source relighting or added lights. The UI stays screen-facing. Mode-local pixels are bound separately because paused and unpaused composites differ slightly.",
      "disposition": "PARTIAL_REUSE_SAMPLE_NEW_USE_AND_ACCEPTANCE_OPEN"
    },
    {
      "axis": "perspective",
      "observation": "The surface remains an interface card in the corner, never a world prop. It is not warped into the environment and keeps the exact screen transform at both widths.",
      "disposition": "PARTIAL_REUSE_SAMPLE_NEW_USE_AND_ACCEPTANCE_OPEN"
    },
    {
      "axis": "scale",
      "observation": "112x112 native/18px offsets and font38 remain unchanged. Paper leaves a clear field for the glyph and all corners remain intact in viewed frames. Exact phone density/performance and squint tests are still absent.",
      "disposition": "PARTIAL_REUSE_SAMPLE_NEW_USE_AND_ACCEPTANCE_OPEN"
    },
    {
      "axis": "contact",
      "observation": "No ground contact is required for this interface. The same named source Button/layer29/owner metadata and original raw touch route open pause and resume. Temporary diagnostic toggle/press/focus/disabled values are restored before actual navigation.",
      "disposition": "PARTIAL_REUSE_SAMPLE_NEW_USE_AND_ACCEPTANCE_OPEN"
    },
    {
      "axis": "occlusion",
      "observation": "The corner card stays over sky in the viewed promenade and above the dimmed pause UI; it does not cover a visible story action in these samples. Other scenes/routes remain unreviewed. Neighboring flat pause panels/buttons/ornaments remain separate debt.",
      "disposition": "PARTIAL_REUSE_SAMPLE_NEW_USE_AND_ACCEPTANCE_OPEN"
    },
    {
      "axis": "readability",
      "observation": "The preserved dark Menu/Back glyphs remain distinct against normal parchment in these views; disabled is visibly muted and the glyph becomes light. Primary font/fallback authority, exact APK coverage, child recognition, focus/kind distinctions in other callers and owner review remain open.",
      "disposition": "PARTIAL_REUSE_SAMPLE_NEW_USE_AND_ACCEPTANCE_OPEN"
    },
    {
      "axis": "action-state",
      "observation": "Final first Back and settled Back paper regions match within that mode; Menu transitions likewise bind to Menu. Each declared state changes actual pixels, including focus-pressed versus focus. These are excluded diagnostics with temporary toggle mode, not proof of natural non-toggle press behavior or formal QA11. The prior machine-only render false positive remains a recorded reject.",
      "disposition": "PARTIAL_REUSE_SAMPLE_NEW_USE_AND_ACCEPTANCE_OPEN"
    }
  ],
