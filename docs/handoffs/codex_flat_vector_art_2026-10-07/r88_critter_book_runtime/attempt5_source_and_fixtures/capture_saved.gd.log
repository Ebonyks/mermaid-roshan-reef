	_check("source reopen resets category without losing or granting collection",_book_snapshot().active and m.collection_category=="fish" and _book_snapshot().caught==0 and _book_snapshot().route_ids==["critter_book"])
	if not await _touch_button(nav,"original_global_Back_reentry_close"):
		return
	await _capture("root_after_reentry_close")
	var finish := _nav_snapshot()
	_check("source caller cleanup restores same root button",not _book_snapshot().active and m.navigation_routes.is_empty() and finish.mode=="menu" and finish.instance_id==id and finish.native_rect==initial.native_rect)
	_check("source caller restyling never duplicates focus bindings",finish.down_connections==down_count and finish.up_connections==up_count and book_nav.down_connections==down_count and book_nav.up_connections==up_count)

func _button(name: String) -> Button:
	return m.start_menu_layer.find_child(name,true,false) as Button if is_instance_valid(m.start_menu_layer) else null

func _point(c: Control) -> Vector2:
	return c.get_global_transform_with_canvas() * (c.size*0.5)

func _input_at(p: Vector2, down: bool, target: String) -> void:
	var e := InputEventScreenTouch.new()
	e.index = 77
	e.position = p
	e.pressed = down
	events.append({"down":down,"mode":mode,"native":[p.x,p.y],"target":target,"ticks_msec":Time.get_ticks_msec(),"private_path":ProjectSettings.globalize_path("user://reef_save.json")})
	root.push_input(e,true)

func _tap(name: String) -> bool:
	var c := _button(name)
	if not _check("original visible button " + name,c != null and c.is_visible_in_tree() and not c.disabled):
		return false
	var p := _point(c)
	_input_at(p,true,name)
	await _frames(1)
	_input_at(p,false,name)
	await _frames(3)
	return true

func _boot() -> bool:
	var scene := load("res://scenes/main.tscn") as PackedScene
	m = scene.instantiate() as ReefMain
	root.add_child(m)
	current_scene = m
	root_id = m.get_instance_id()
	if not await _wait(func() -> bool: return is_instance_valid(m.start_menu_layer) and m.get_node_or_null("BootSplashHandoff") == null,18.0):
		errors.append("original display startup timeout")
		return false
	return _check("source display uses StartMenu not IntroOverlay",m.start_menu_active and m.intro_active and m.intro_layer == null and m._intro_overlay == null and ProjectSettings.globalize_path(m._save_state.save_path) == private_path)

func _confirm(prefix: String) -> bool:
	if not await _tap("StartMenuNewGameButton"):
		return false
	await _capture(prefix + "_arm_delay", "EXCLUDED_BOOTSTRAP_CONTROL")
	var b := _button("StartMenuConfirmNewGameButton")
	if not _check("source newgame initially delayed",b != null and b.disabled):
		return false
	if not await _wait(func() -> bool: return not b.disabled,3.0):
		errors.append("source arm delay timeout")
		return false
	return true

func _retire() -> void:
	if is_instance_valid(m):
		m.queue_free()
		await _frames(14)
		m = null

func _exercise() -> void:
	mode="DECLARED_SYNTHETIC_SAVED_BOOK_CONSUMER"
	saved_mode=OS.get_environment("R88_SAVED_MODE")
	if saved_mode not in ["partial","full"]:
		errors.append("invalid private saved mode")
		return
	expected_caught=6 if saved_mode=="partial" else 18
	_seed_saved()
	if not await _boot_saved():
		return
	await _capture("saved_checkpoint","EXCLUDED_SYNTHETIC_BOOTSTRAP")
	var before: Dictionary = m.critter_collection.duplicate(true)
	var counters: Array = [m.opera_stars,m.opera_progress,m.pearl_count]
	_check("seeded collection loaded by original SaveState",before==synthetic_seed.critters and m._collection_ref().caught_count()==expected_caught)
	if not await _open_saved_book():
		return
	await _capture("saved_initial_fish")
	_check("saved fish card semantics",_saved_card_semantics())
	for index: int in [1,2,0,0]:
		if not await _touch_button(_book_tab(index),"original_saved_category_"+str(index)):
			return
		await _capture("saved_category_"+str(index)+"_"+str(states.size()))
		_check("source category/card semantics and collection preserved",_saved_card_semantics() and m.critter_collection==before and m._collection_ref().caught_count()==expected_caught)
	m.notification(MainLoop.NOTIFICATION_APPLICATION_PAUSED)
	await _frames(3)
	await _capture("saved_pause_notification")
	m.notification(MainLoop.NOTIFICATION_APPLICATION_RESUMED)
	await _frames(3)
	await _capture("saved_resume_notification")
	_check("notifications preserve page and saved collection",m.collection_stage!=null and m.collection_category=="fish" and m.critter_collection==before)
	if not await _touch_button(m.global_navigation_button,"original_saved_Back"):
		return
	await _capture("saved_Back_closed")
	_check("actual saved Back closes book",m.collection_stage==null)
	if not await _open_saved_book():
		return
	await _capture("saved_reentry_fish")
	_check("reentry resets fish and preserves counters",m.collection_category=="fish" and m.critter_collection==before and [m.opera_stars,m.opera_progress,m.pearl_count]==counters)
	if OS.get_environment("R88_TEXT_STRESS")=="1":
		await _text_expansion_stress()
	if not await _touch_button(m.global_navigation_button,"original_saved_Back_before_reload"):
		return
	await _retire()
	if not await _boot_saved():
		return
	await _capture("saved_reload_checkpoint","EXCLUDED_SYNTHETIC_BOOTSTRAP")
	_check("new Main loaded same original saved collection",m.critter_collection==before and m.critter_collection.get("r88_future_species",true)==false)
	if not await _open_saved_book():
		return
	await _capture("saved_reload_book")
	_check("reloaded exact saved card meanings",_saved_card_semantics())
	var disk: Variant = JSON.parse_string(FileAccess.get_file_as_string(private_path))
	_check("private unknown future field retained",disk is Dictionary and _json_equal(disk.get("flat_vector_private_unknown"),synthetic_seed.flat_vector_private_unknown))
	if not await _touch_button(m.global_navigation_button,"original_saved_final_Back"):
		return
	await _capture("saved_reload_Back_closed")


func _run() -> void:
	var engine := Engine.get_version_info()
	if int(engine.major)!=4 or int(engine.minor)!=7 or int(engine.patch)!=2 or engine.status!="stable" or engine.build!="official" or RenderingServer.get_current_rendering_method()!="mobile" or DisplayServer.get_name()=="headless":
		quit(1)
		return
	var width := int(OS.get_environment("R88_WIDTH"))
	out_dir = OS.get_environment("R88_OUT")
	var private_name := OS.get_environment("R88_PRIVATE_NAME")
	if out_dir.is_empty() or DirAccess.dir_exists_absolute(out_dir) or width not in [1280,1600] or private_name.is_empty() or private_name.contains("/") or private_name.contains("\\") or private_name.contains(":"):
		quit(1)
		return
	normal_path = ProjectSettings.globalize_path("user://reef_save.json")
	normal_before = _normal_hashes()
	old_custom = bool(ProjectSettings.get_setting("application/config/use_custom_user_dir",false))
	old_custom_name = String(ProjectSettings.get_setting("application/config/custom_user_dir_name",""))
	ProjectSettings.set_setting("application/config/use_custom_user_dir",true)
	ProjectSettings.set_setting("application/config/custom_user_dir_name",private_name)
	private_path = ProjectSettings.globalize_path("user://reef_save.json")
	settings_configured = true
	var fresh := true
	for v: Variant in _private_hashes().values():
		fresh = fresh and v=="absent"
	var isolated := private_path!=normal_path and private_path.get_base_dir().get_file()==private_name and fresh
	_check("private user namespace remaps before any Main load and is fresh",isolated)
	DirAccess.make_dir_recursive_absolute(out_dir)
	if isolated:
		DirAccess.make_dir_recursive_absolute(private_path.get_base_dir())
		if _prepare_cache_tree(normal_path.get_base_dir().path_join("shader_cache")) and await _aspect(width):
			await _exercise()
	await _retire()
	ProjectSettings.set_setting("application/config/use_custom_user_dir",old_custom)
	ProjectSettings.set_setting("application/config/custom_user_dir_name",old_custom_name)
	_check("normal user path restored after source teardown",ProjectSettings.globalize_path("user://reef_save.json")==normal_path)
	_check("normal eleven save-name hashes unchanged",_normal_hashes()==normal_before)
	var report := {"schema":"reef.critter_book_runtime/1","source_revision":OS.get_environment("R88_REV"),"engine":engine,"renderer":RenderingServer.get_current_rendering_method(),"display":DisplayServer.get_name(),"aspect":[width,720],"time_scale":Engine.time_scale,"private_path":private_path,"normal_path":normal_path,"private_hashes_final":_private_hashes(),"cache_directory_structure_only":cache_directories,"normal_before":normal_before,"normal_after":_normal_hashes(),"states":states,"events":events,"checks":checks,"errors":errors,"pointer_samples":pointer_samples,"flash_trials":flash_trials,"flash_lifecycle":flash_lifecycle,"final_mode":mode,"observer_status":"PASS" if errors.is_empty() else "FAIL","actual_child_data":false,"production_changes_in_source_revision":[],"production_changes_in_this_audit":["scripts/collection_system.gd","scripts/storybook_ui.gd","scripts/pause_menu.gd","scripts/navigation_controller.gd"],"published_navigation_dependency":"684e34f06ebce6a70065847b5ecb69547ea8a128","candidate_code_sha256":OS.get_environment("R88_CODE_SHA256"),"saved_mode":saved_mode,"expected_caught":expected_caught,"synthetic_seed":synthetic_seed,"expansion_records":expansion_records,"scope":"Declared synthetic partial/full saved consumer only: private seed before Main, original auto SaveState/Continue/Menu/Critters/tabs/Back/reentry/reload. Explicit pre-activity postboss Castle bootstrap, no natural catch journey. Optional text-only130percent stress is excluded and restored before source controls resume. No source pixels/collection awards or actual child data; no firstdraw/formalQA11/device/child/owner acceptance."}
	var f := FileAccess.open(out_dir.path_join("capture_manifest.json"),FileAccess.WRITE)
	f.store_string(JSON.stringify(report,"\t",true)+"\n")
	f.close()
	print("BOOK88|RESULT|",report.observer_status,"|",errors)
	quit(0 if errors.is_empty() else 1)


func _book_visuals() -> Dictionary:
	var panels: Array[Dictionary] = []
	var buttons: Array[Dictionary] = []
	var labels: Array[Dictionary] = []
	var textures: Array[Dictionary] = []
	if not is_instance_valid(m.collection_stage):
		return {}
	var queue: Array[Node] = [m.collection_stage]
	while not queue.is_empty():
		var node: Node = queue.pop_front()
		if node.is_queued_for_deletion():
			continue
		if node is Panel:
			var panel := node as Panel
			panels.append({"name":String(panel.name),"position":_v(panel.position),"size":_v(panel.size),"style":_style_data(panel.get_theme_stylebox("panel"))})
		if node is Button:
			var button := node as Button
			var styles: Dictionary = {}
			for state: String in ["normal","hover","pressed","hover_pressed","focus","disabled"]:
				styles[state]=_style_data(button.get_theme_stylebox(state))
			buttons.append({"name":String(button.name),"text":button.text,"rect":[button.position.x,button.position.y,button.size.x,button.size.y],"min_size":_v(button.custom_minimum_size),"pressed":button.is_pressed(),"focus":button.has_focus(),"disabled":button.disabled,"draw_mode":button.get_draw_mode(),"styles":styles,"pressed_callbacks":button.pressed.get_connections().size(),"callback_methods":_button_methods(button)})
		if node is Label:
			var label := node as Label
			var font: Font = label.get_theme_font("font")
			var font_size: int = label.get_theme_font_size("font_size")
			labels.append({"name":String(label.name),"text":label.text,"position":_v(label.position),"size":_v(label.size),"parent_size":_v((label.get_parent()as Control).size) if label.get_parent()is Control else [],"font_size":font_size,"font_class":font.get_class(),"font_path":font.resource_path,"unwrapped_width":font.get_string_size(label.text,HORIZONTAL_ALIGNMENT_LEFT,-1,font_size).x,"line_count":label.get_line_count(),"line_height":label.get_line_height(),"wrap_mode":label.autowrap_mode,"max_lines":label.max_lines_visible,"clip":label.clip_text,"role":String(label.get_meta("typography_role",""))})
		if node is TextureRect:
			var picture := node as TextureRect
			var atlas := picture.texture as AtlasTexture
			if atlas!=null:
				textures.append({"name":String(picture.name),"source":atlas.atlas.resource_path,"sha256":FileAccess.get_sha256(atlas.atlas.resource_path),"region":[atlas.region.position.x,atlas.region.position.y,atlas.region.size.x,atlas.region.size.y],"position":_v(picture.position),"size":_v(picture.size),"mouse_filter":picture.mouse_filter})
		for child: Node in node.get_children():
			queue.append(child)
	return {"panels":panels,"buttons":buttons,"labels":labels,"textures":textures}

func _check_book(state: String) -> void:
	var visual := _book_visuals()
	var title: Label = _book_label(StorybookUI.ROLE_TITLE)
	var help: Label = _book_label(StorybookUI.ROLE_ADULT_CAPTION)
	var text_fits: bool = title!=null and help!=null
	for label: Label in [title,help]:
		if label!=null:
			var font: Font = label.get_theme_font("font")
			text_fits=text_fits and label.size.x>=font.get_string_size(label.text,HORIZONTAL_ALIGNMENT_LEFT,-1,label.get_theme_font_size("font_size")).x and label.position.x>=0 and label.position.x+label.size.x<=1280 and label.position.y>=0 and label.position.y+label.size.y<=720 and label.size.x>1
	_check(state+" title/help actual shaped width and viewport fit",text_fits)
	var all_painted: bool = visual.panels.size()==7 and visual.buttons.size()==3
	for panel: Dictionary in visual.panels:
		all_painted=all_painted and panel.style.class=="StyleBoxTexture" and panel.style.texture_sha256=="ab4926b5c99c3c6db0efcb4a20a75a9128276e085189bf51f947025659525893"
	for button: Dictionary in visual.buttons:
		all_painted=all_painted and button.min_size==[242.0,110.0] and button.rect[2]>=242 and button.rect[3]>=110 and button.pressed_callbacks==2 and button.callback_methods.count("_switch_category")==1 and button.callback_methods.count("_ui_tap")==1
		for style: Dictionary in button.styles.values():
			all_painted=all_painted and style.class=="StyleBoxTexture" and style.texture_sha256=="ab4926b5c99c3c6db0efcb4a20a75a9128276e085189bf51f947025659525893"
	_check(state+" actual board/cards/all six native button states painted with original large targets/callback",all_painted)
	var original_ornaments_absent: bool = true
	for name: String in ["CritterBookShellCrest","CritterBookPearlTL","CritterBookPearlTR","CritterBookPearlBL","CritterBookPearlBR"]:
		original_ornaments_absent=original_ornaments_absent and m.collection_stage.get_node_or_null(name)==null
	_check(state+" original procedural fan/pearls not constructed",original_ornaments_absent)
	var shell_fit: bool = visual.textures.size()==2
	for picture: Dictionary in visual.textures:
		shell_fit=shell_fit and picture.size[0]<=64 and picture.size[1]<=48 and picture.source=="res://assets/fashion/skin_engine_v2/ui/wardrobe_panel.png" and picture.region==[430.0,0.0,165.0,116.0]
	_check(state+" exact painted header/selection source and bounded crop sizes",shell_fit)
	var type_floor: bool = true
	for label: Dictionary in visual.labels:
		if label.name=="CritterBookSpeciesName" or label.name=="CritterBookHabitat":
			type_floor=type_floor and label.font_size>=28 and label.position[0]+label.size[0]<=label.parent_size[0] and label.position[1]+label.size[1]<=label.parent_size[1]
	_check(state+" current card text floor and bounds",type_floor)


func _button_methods(button: Button) -> Array[String]:
	var methods: Array[String] = []
	for connection: Dictionary in button.pressed.get_connections():
		var callback: Callable = connection["callable"]
		methods.append(String(callback.get_method()))
	return methods

func _book_label(role: StringName) -> Label:
	for child: Node in m.collection_stage.get_children():
		if child is Label and not child.is_queued_for_deletion() and child.get_meta("typography_role",&"")==role:
			return child as Label
	return null


func _seed_saved() -> void:
	synthetic_seed={"schema_version":1,"save_generation":7,"plays":3,"day_one_active":false,"day_one_giant_dust_bunny_boss_defeated":true,"day_one_completed_rooms":DayOneDirector.ROOM_ORDER,"day_one_cleaned_rooms":DayOneDirector.ROOM_ORDER,"day_one_giant_dust_bunny_boss_triggered":true,"chapter2_active":true,"chapter2_unlocked_opera_mask":0x0449,"chapter2_job_phase_masks":[0,0,0,0,0,0,0,0],"music":false,"mic":false,"quality":"speedy","pearls":23,"pearls_ever":23,"flat_vector_private_unknown":{"token":"R88_SYNTHETIC_ONLY","keep":[3,7]},"crafts":{},"stickers":{},"custom_fish":[],"custom_friends":[]}
	var critters: Dictionary = {"r88_future_species":false}
	for index: int in range(CollectionSystem.DEFS.size()):
		if saved_mode=="full" or index in [0,2,6,11,13,17]:
			critters[String(CollectionSystem.DEFS[index].id)]=true
	synthetic_seed["critters"]=critters
	var file := FileAccess.open(private_path,FileAccess.WRITE)
	file.store_string(JSON.stringify(synthetic_seed,"\t",true)+"\n")
	file.close()

func _boot_saved() -> bool:
	var packed := load("res://scenes/main.tscn") as PackedScene
	m=packed.instantiate() as ReefMain
	root.add_child(m)
	current_scene=m
	if not await _wait(func() -> bool:return is_instance_valid(m.start_menu_layer) and m.get_node_or_null("BootSplashHandoff")==null,18.0):
		errors.append("saved startup timeout")
		return false
	_check("automatic original SaveState consumes private namespace/Speedy",ProjectSettings.globalize_path(m._save_state.save_path)==private_path and m.quality=="speedy" and m.has_saved_game)
	if not await _touch_button(_button("StartMenuContinueButton"),"original_saved_Continue"):
		return false
	if m.intro_active:
		m._skip_intro()
	if not await _wait(func() -> bool:return not m.start_menu_active and not m.intro_active,15.0):
		errors.append("saved Continue did not settle")
		return false
	# Declared synthetic startup routing only, before measured book activity.
	m.game="level2"
	m.g["t"]=0.0
	m._enter_castle_interior_now(false)
	await _frames(40)
	return true

func _open_saved_book() -> bool:
	var nav: Button = m.global_navigation_button
	if String(nav.get_meta("global_navigation_mode",""))!="menu":
		if not await _touch_button(nav,"original_saved_return_root"):
			return false
		await _frames(45)
	_check("saved original Menu available",String(nav.get_meta("global_navigation_mode",""))=="menu")
	if not await _touch_button(nav,"original_saved_Menu"):
		return false
	var choice := m.pause_panel.find_child("MenuCritterBookButton",true,false) as Button
	if not await _touch_button(choice,"original_saved_MenuCritterBookButton"):
		return false
	_check("saved original Critters callback owns book",m.collection_stage!=null and _book_snapshot().route_ids.back()=="critter_book" and not paused)
	return m.collection_stage!=null

func _saved_card_semantics() -> bool:
	var cards: Array[Panel] = []
	for child: Node in m.collection_stage.get_children():
		if child is Panel and not child.is_queued_for_deletion() and (child as Panel).size.x<1000:
			cards.append(child as Panel)
	var defs: Array[Dictionary] = []
	for definition: Dictionary in CollectionSystem.DEFS:
		if String(definition.category)==m.collection_category:
			defs.append(definition)
	if cards.size()!=defs.size() or cards.size()!=6:
		return false
	for index: int in range(cards.size()):
		var definition: Dictionary = defs[index]
		var caught: bool = bool(m.critter_collection.get(String(definition.id),false))
		var name_label := cards[index].get_node_or_null("CritterBookSpeciesName") as Label
		var category_label := cards[index].get_node_or_null("CritterBookCategoryOrUnknown") as Label
		var habitat := cards[index].get_node_or_null("CritterBookHabitat") as Label
		if name_label==null or category_label==null or habitat==null:
			return false
		if name_label.text!=(String(definition.name)if caught else "Mystery Friend") or category_label.text!=(String(CollectionSystem.CATEGORY_ICON[m.collection_category])if caught else "?") or habitat.text!="%s  %s"%[CollectionSystem.HABITAT_ICON[String(definition.habitat)],CollectionSystem.HABITAT_LABEL[String(definition.habitat)]]:
			return false
	return true

func _text_expansion_stress() -> void:
	var original: Array[Dictionary] = []
	for child: Node in m.collection_stage.find_children("*","Label",true,false):
		var label := child as Label
		if label==null or label.is_queued_for_deletion():
			continue
		var role: String = String(label.get_meta("typography_role",&""))
		if String(label.name)not in ["CritterBookSpeciesName","CritterBookHabitat"] and role not in ["title","adult_caption"]:
			continue
		var font: Font = label.get_theme_font("font")
		var size: int = label.get_theme_font_size("font_size")
		var width: float = font.get_string_size(label.text,HORIZONTAL_ALIGNMENT_LEFT,-1,size).x
		original.append({"node":label,"text":label.text})
		var counter: int = 0
		while font.get_string_size(label.text,HORIZONTAL_ALIGNMENT_LEFT,-1,size).x<width*1.30 and counter<40:
			label.text+=" x"
			counter+=1
		expansion_records.append({"role":role,"name":String(label.name),"source_text":original.back().text,"expanded_text":label.text,"before_width":width,"required_width":width*1.30,"actual_expanded_width":font.get_string_size(label.text,HORIZONTAL_ALIGNMENT_LEFT,-1,size).x,"font_size":size,"recipe":"Append ASCII x suffix tokens until measured unwrapped width is at least130percent; no supported language claimed."})
	await _frames(8)
	await _capture("saved_130percent_expansion","EXCLUDED_TEXT_EXPANSION_STRESS")
	for entry: Dictionary in original:
		(entry.node as Label).text=entry.text
	await _frames(8)
	await _capture("saved_text_restored")
	_check("text-only stress restored original collection meanings",_saved_card_semantics())

func _json_equal(left: Variant, right: Variant) -> bool:
	# Normalize both sides through JSON: saved JSON numbers reload as floats.
	return JSON.parse_string(JSON.stringify(left))==JSON.parse_string(JSON.stringify(right))
