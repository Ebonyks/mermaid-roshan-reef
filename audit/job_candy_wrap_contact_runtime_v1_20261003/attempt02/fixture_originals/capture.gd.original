extends SceneTree
## NON_RUNTIME_CONTACT_COUNTERFACTUAL. Surface drawing and phase2 actor visibility only.
## Actual Kitchen card, inherited input/progress and earned phases/return.
## Story prerequisites are an explicit isolated restored-save fixture; no phase forcing.
const OUT := "res://audit/job_candy_wrap_contact_runtime_v1_20261003/attempt02/"
var main: ReefMain
var world: OperaCareerWorld2D
var width_now := 1280
var story := false
var lane := "training"
var recording := false
var motion_frames: Array[Dictionary] = []
var views: Array[Dictionary] = []
var events: Array[Dictionary] = []
var input_events: Array[Dictionary] = []

func _initialize() -> void:
	_run.call_deferred()

func _wait(count: int) -> void:
	for _i: int in range(count):
		await process_frame
		if recording:
			await RenderingServer.frame_post_draw
			_capture_motion()

func _state() -> Dictionary:
	var s := world.surface as OperaGestureSurface
	return {"phase":world.phase_index,"phase_name":world.phases[world.phase_index].get("name",""),
		"milestone":world.phases[world.phase_index].get("milestone",""),"mode":s.mode,"context":s.visual_context,
		"task_open":world.task_open,"phase_progress":world.phase_progress,"advance_pending":world.phase_advance_pending,
		"widget_fill":s.widget_fill,"crank_rotation":s.crank_rotation,"pour_tilt":s.pour_tilt,
		"pour_level":s.pour_level,"pour_reserve":s.pour_reserve,"held":s.held,"pointer":s.pointer_pos,
		"candy_sorted":s.candy_sorted,"candy_position":s.candy_position,"candy_type":s.candy_type,
		"target_placed":s.target_placed,"completion_accepted":s.completion_accepted,
		"source_key":s.get("last_source_key"),"source_region":s.get("last_source_region"),"draw_rect":s.get("last_draw_rect"),"actor_visible":world.player_actor.visible,
		"actor_position":world.player_actor.position,"actor_size":world.player_actor.size,"actor_texture":world.player_actor.texture.resource_path,
		"surface_position":s.position,"surface_size":s.size,"surface_modulate":s.modulate,
		"cake_mask":main.chapter2_cake_piece_mask,"party_mask":main.chapter2_party_piece_mask,
		"visible_story_action":world.action_panel.get_meta("chapter2_candy_visible_action",""),
		"visible_story_berry_count":world.action_panel.get_meta("chapter2_candy_visible_berry_count",0)}

func _capture_motion() -> void:
	var index := motion_frames.size()
	var path := OUT+"native_frames/%s_%d_%04d.webp" % [lane,width_now,index]
	var im := root.get_texture().get_image()
	assert(im.save_webp(path,true)==OK)
	motion_frames.append({"path":path.trim_prefix("res://"),"sha256":FileAccess.get_sha256(path),"index":index,
		"width":width_now,"lane":lane,"time_msec":Time.get_ticks_msec(),"state":_state(),"direct_review":false,"scores":{},"owner_acceptance":null})

func _view(tag: String) -> void:
	await RenderingServer.frame_post_draw
	var path := OUT+"native_views/%s_%d_%02d_%s.webp" % [lane,width_now,views.size(),tag]
	assert(root.get_texture().get_image().save_webp(path,true)==OK)
	views.append({"path":path.trim_prefix("res://"),"sha256":FileAccess.get_sha256(path),"tag":tag,"width":width_now,
		"lane":lane,"state":_state() if is_instance_valid(world) and world.surface!=null else {},"direct_review":false,"scores":{}})

func _touch(at: Vector2, pressed: bool) -> void:
	var e := InputEventScreenTouch.new()
	e.index=0
	e.position=at
	e.pressed=pressed
	Input.parse_input_event(e)
	input_events.append({"kind":"down" if pressed else "up","at":at,"time_msec":Time.get_ticks_msec()})
	await _wait(2)

func _surface_touch(at: Vector2, pressed: bool) -> void:
	await _touch(world.surface.get_global_transform_with_canvas()*at,pressed)

func _drag(at: Vector2) -> void:
	var e := InputEventScreenDrag.new()
	e.index=0
	e.position=world.surface.get_global_transform_with_canvas()*at
	Input.parse_input_event(e)
	input_events.append({"kind":"drag","at":e.position,"time_msec":Time.get_ticks_msec()})
	await _wait(2)

func _tap(c: Control) -> void:
	var at := c.get_global_transform_with_canvas()*(c.size*0.5)
	await _touch(at,true)
	await _touch(at,false)

func _open() -> void:
	for _i: int in range(400):
		var h := world._active_hotspot()
		if h!=null and h.visible:
			break
		await _wait(1)
	var h := world._active_hotspot()
	assert(h!=null and h.visible and not world.task_open)
	await _view("phase%d_invitation" % world.phase_index)
	await _tap(h.touch_button)
	for _i: int in range(400):
		if world.task_open:
			break
		await _wait(1)
	assert(world.task_open)
	if world.phase_index==2:
		world.player_actor.visible=false
	await _wait(8)
	await _view("phase%d_task_open" % world.phase_index)

func _work() -> void:
	var phase := world.phase_index
	var s := world.surface as OperaGestureSurface
	var mode := s.mode
	var initial := _state()
	match mode:
		"bop":
			for _i: int in range(160):
				if world.phase_advance_pending or world.phase_index!=phase:
					break
				var target: Control = null
				for imp: Dictionary in world.combat_imps:
					if not bool(imp.get("popped",false)) and is_instance_valid(imp.get("node")):
						target=imp["node"] as Control
						break
				if target!=null:
					await _tap(target)
				else:
					await _wait(2)
		"pourt":
			await _surface_touch(s._pour_pitcher_hit_rect().get_center(),true)
			for _i: int in range(500):
				if world.phase_advance_pending or world.phase_index!=phase:
					break
				await _wait(1)
			await _surface_touch(s.pointer_pos,false)
		"choice":
			for _i: int in range(40):
				if world.phase_advance_pending or world.phase_index!=phase:
					break
				var at := Vector2((float(s.target_choice)+0.5)*s.size.x/float(s.choice_count),s.size.y*0.5)
				await _surface_touch(at,true)
				await _surface_touch(at,false)
		"circle":
			var centre := s._circle_pivot()
			var radius := minf(s.size.x,s.size.y)*0.24
			await _surface_touch(centre+Vector2(radius,0),true)
			for step: int in range(400):
				if world.phase_advance_pending or world.phase_index!=phase:
					break
				await _drag(centre+Vector2.from_angle(float(step+1)*TAU/32.0)*radius)
				if step==16 or step==32:
					await _view("phase%d_circle_step%d" % [phase,step])
			await _surface_touch(s.pointer_pos,false)
		"candy_sort":
			for piece: int in range(6):
				if world.phase_advance_pending or world.phase_index!=phase:
					break
				var at := s.candy_position
				var to := s._candy_bin_rect(s.candy_type).get_center()
				await _surface_touch(at,true)
				for step: int in range(1,11):
					await _drag(at.lerp(to,float(step)/10.0))
				await _surface_touch(to,false)
				await _wait(6)
		"tap":
			for _i: int in range(16):
				if world.phase_advance_pending or world.phase_index!=phase:
					break
				var target := s._target_next_unplaced()
				var at := s._target_anchor_point(target) if target>=0 else s.size*0.5
				await _surface_touch(at,true)
				await _surface_touch(at,false)
				await _wait(4)
		_:
			push_error("Unimplemented current mode "+mode)
			quit(3)
			return
	assert(world.phase_advance_pending or world.phase_index!=phase)
	await _view("phase%d_earned_completion" % phase)
	events.append({"event":"intentional_phase_completed","phase":phase,"mode":mode,"initial":initial,"after":_state()})

func _run() -> void:
	Engine.max_fps=30
	assert(DisplayServer.get_name()!="headless")
	for a: String in OS.get_cmdline_user_args():
		if a.begins_with("--width="):
			width_now=a.trim_prefix("--width=").to_int()
		if a=="--story":
			story=true
	lane="story" if story else "training"
	root.size=Vector2i(width_now,720)
	DisplayServer.window_set_size(root.size)
	assert(DirAccess.make_dir_recursive_absolute(OUT+"native_views/")==OK)
	assert(DirAccess.make_dir_recursive_absolute(OUT+"native_frames/")==OK)
	main=(load("res://scenes/main.tscn") as PackedScene).instantiate() as ReefMain
	root.add_child(main)
	await _wait(5)
	main.day_one_active=false
	main._skip_intro()
	main._start_menu_ref()._dismiss_menu()
	main.game="level2"
	main.g["t"]=0.0
	main._enter_castle_interior_now(false)
	await _wait(20)
	var fixture := {"day_one_giant_dust_bunny_boss_defeated":true,"chapter2_party_piece_mask":65,
		"chapter2_strawberry_mask":31,"chapter2_cake_piece_mask":31,"chapter2_job_phase_masks":[15,31,0,0,0,0,0,0]}
	main._chapter_two_ref().restore_state(fixture if story else {})
	events.append({"event":"EXPLICIT_ISOLATED_ENTRY_SAVE_FIXTURE","story_prerequisites":fixture if story else {},"qualification":"Prior Farmer/Chef completion seeded only at entry; Candy phases/results are earned through actual input. This is not full preceding-story travel evidence."})
	var rooms := main._castle_rooms_ref()
	rooms.show_room("kitchen",false)
	await _wait(12)
	var routes := main._castle_career_routes_ref()
	routes.sync()
	assert(CastleCareerRoutes.room_for_act(3)=="kitchen")
	var card := routes.button_for_act(3)
	assert(card!=null and card.is_visible_in_tree() and not card.disabled)
	await _view("actual_kitchen_card")
	await _tap(card)
	for _i: int in range(900):
		if main.opera_game!=null and main.opera_game.act!=null:
			break
		await _wait(1)
	assert(main.opera_game!=null and main.opera_game.act!=null)
	world=main.opera_game.act.career_world_2d
	assert(world!=null and world.phase_index==0 and not world.two_act_enabled)
	assert(world.using_chapter_two_phases==story)
	assert(world.phases.size()==4)
	for _i: int in range(180):
		if main.fade_rect==null or main.fade_rect.modulate.a<=0.02:
			break
		await _wait(1)
	await _wait(8)

	# Explicit drawing-only surface substitution. Copy all inherited script state,
	# transforms and actual signal callables; validate snapshot before opening.
	var original := world.surface as OperaGestureSurface
	var replacement := (load("res://audit/job_candy_wrap_contact_runtime_v1_20261003/contact_surface.gd") as GDScript).new() as OperaGestureSurface
	var parent := original.get_parent()
	parent.add_child(replacement)
	parent.move_child(replacement,original.get_index())
	var snapshot: Dictionary = {}
	for property: Dictionary in original.get_property_list():
		if int(property.get("usage",0)) & PROPERTY_USAGE_SCRIPT_VARIABLE:
			var value: Variant = original.get(property["name"])
			if value is Array or value is Dictionary:
				value=value.duplicate(true)
			snapshot[String(property["name"])]=value
			replacement.set(property["name"],value)
	for key: String in ["position","size","visible","mouse_filter","texture_filter","process_mode","modulate"]:
		replacement.set(key,original.get(key))
	for signal_name: String in ["gesture","progress_changed"]:
		for connection: Dictionary in original.get_signal_connection_list(signal_name):
			replacement.connect(signal_name,connection["callable"],int(connection["flags"]))
		assert(replacement.get_signal_connection_list(signal_name).size()==original.get_signal_connection_list(signal_name).size())
	world.surface=replacement
	var after_snapshot: Dictionary = {}
	for property_name: String in snapshot:
		after_snapshot[property_name]=replacement.get(property_name)
	assert(after_snapshot==snapshot)
	assert(replacement.get_global_transform_with_canvas()==original.get_global_transform_with_canvas())
	original.queue_free()
	await _wait(4)
	events.append({"event":"EXPLICIT_NON_RUNTIME_DRAWING_ONLY_CONTACT_SURFACE_SUBSTITUTION","source":FileAccess.get_sha256("res://assets_src/imagegen/candy_wrap_contact_v1_20261003/attempt03/native.png"),"snapshot_unchanged_at_substitution":after_snapshot==snapshot,"copied_inherited_property_count":snapshot.size(),"original_input_pivot_retained":true,"production_binding":false})
	for phase: int in range(world.phases.size()):
		assert(world.phase_index==phase)
		world.player_actor.visible=true
		var full_action := phase==2
		if full_action:
			recording=true
		await _open()
		await _work()
		if phase<world.phases.size()-1:
			for _i: int in range(400):
				if world.phase_index==phase+1:
					break
				await _wait(1)
			assert(world.phase_index==phase+1)
		else:
			for _i: int in range(600):
				if main.opera_game==null:
					break
				await _wait(1)
		if full_action:
			recording=false
			events.append({"event":"complete_circle_sequence_recorded","phase":phase,"frames":motion_frames.size()})
	assert(main.opera_game==null and main.game=="level2" and main.castle_room_id=="kitchen")
	await _wait(12)
	await _view("actual_earned_kitchen_return")
	events.append({"event":"actual_earned_career_return","stars":main.opera_stars,"party_mask":main.chapter2_party_piece_mask,"cake_mask":main.chapter2_cake_piece_mask})
	if story:
		assert(main.chapter2_cake_piece_mask==127 and (main.chapter2_party_piece_mask&8)!=0)
	var file := FileAccess.open(OUT+"CAPTURE_%s_%d.json" % [lane,width_now],FileAccess.WRITE)
	file.store_string(JSON.stringify({"status":"ACTUAL_CANDY_ROUTE_ALL_PHASES_EARNED_COMPLETE_CIRCLE_SEQUENCE_REVIEW_PENDING","lane":lane,"width":width_now,"motion_frames":motion_frames,"views":views,"events":events,"input_events":input_events,"qualification":"Explicit NON_RUNTIME contact source-key drawing substitute and phase2 room actor hidden to avoid duplicate Roshan. Four static authored keys, not temporal in-betweens. Original circle pivot and input intentionally retained to expose any visual/input mismatch. Actual production Kitchen picture-card route, finger0 input, all career phases earned and normal Kitchen return. Complete circle action only (training WRAP / story GLAZE) from invitation through next phase; other phases selected canvases. Explicit isolated Main/Castle entry and prior Farmer/Chef restored-save fixture for story. Explicit declared surface replacement; no phase forcing, manual ticks, signal completion or patched callbacks. Slow readback/desktop Mobile are not natural timing/device/child/owner acceptance."},"\t"))
	file.close()
	print("CANDY_WORKFLOW|",lane,"|",width_now,"|ALL_PHASES_EARNED_RETURN_AND_CIRCLE_CAPTURE|PASS_REVIEW_PENDING")
	quit(0)
