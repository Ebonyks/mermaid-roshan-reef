+LEARNING_COMMIT = "7b851b3d0be0dd83652751ca5c3085fc4b36b6b8"
+SAVE_KEY = re.compile(r'"((?:chapter2_|chapter3_|day_one_|day_two_|fairy)[A-Za-z0-9_]*)"')
