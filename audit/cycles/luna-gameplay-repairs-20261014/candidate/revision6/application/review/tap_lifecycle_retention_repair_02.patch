+func _route_tap(control: Variant, at: Vector2) -> bool:
+	if not is_instance_valid(control) or not control is Control:
+		_check("viewport: tap begins on a valid Control", false)
+		return false
+	var target := control as Control
+	var viewport := target.get_viewport()
+	var point := _route_point(target, at)
+	_route_viewport_touch(viewport, point, true)
+	await process_frame
+	if not is_instance_valid(viewport):
+		_check("viewport: tap retains its input Viewport through release", false)
+		return false
+	_route_viewport_touch(viewport, point, false)
+	await process_frame
+	return true
 
 
