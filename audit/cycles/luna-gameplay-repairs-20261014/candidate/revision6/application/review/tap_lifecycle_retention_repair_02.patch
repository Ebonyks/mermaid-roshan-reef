+func _fixture_freeze_input(source: String, destination: String, expected_hash: String) -> bool:
+	if source not in [fixture_save_path, fixture_save_path + ".bak"] or expected_hash.is_empty():
+		return false
+	if destination.get_base_dir() != fixture_save_path.get_base_dir() \
+			or not destination.begins_with(fixture_save_path + ".milestone_") \
+			or not (destination.ends_with(".primary.input.json") or destination.ends_with(".backup.input.json")) \
+			or FileAccess.file_exists(destination):
+		return false
+	if FileAccess.get_sha256(source) != expected_hash:
+		return false
+	var bytes := FileAccess.get_file_as_bytes(source)
+	if bytes.is_empty():
+		return false
+	var file := FileAccess.open(destination, FileAccess.WRITE)
+	if file == null:
+		return false
+	file.store_buffer(bytes)
+	file.flush()
+	file.close()
+	return FileAccess.get_sha256(destination) == expected_hash and FileAccess.get_sha256(source) == expected_hash
+
