+func _audit_route_tap_lifetime() -> void:
+	# A production Continue may remove its own stage on press. The release
+	# must still reach the same Viewport once, without using the freed Control.
+	var observer := TapLifecycleObserver.new()
+	root.add_child(observer)
+	var target := Button.new()
+	target.position = Vector2(400, 240)
+	target.size = Vector2(144, 144)
+	target.action_mode = BaseButton.ACTION_MODE_BUTTON_PRESS
+	target.button_down.connect(target.queue_free)
+	root.add_child(target)
+	await process_frame
+	var expected_point := _route_point(target, target.size * 0.5)
+	var removed: WeakRef = weakref(target)
+	var completed: Variant = await _route_tap(target, target.size * 0.5)
+	var observed := observer.touches
+	_check("viewport: a removed-on-press Control still sends exactly one matching release",
+		completed is bool and bool(completed) and removed.get_ref() == null and observed.size() == 2
+		and bool(observed[0]["pressed"]) and not bool(observed[1]["pressed"])
+		and int(observed[0]["index"]) == 71 and int(observed[1]["index"]) == 71
+		and (observed[0]["position"] as Vector2).is_equal_approx(expected_point)
+		and (observed[1]["position"] as Vector2).is_equal_approx(expected_point))
+	if removed.get_ref() != null:
+		(removed.get_ref() as Node).queue_free()
+	observer.queue_free()
+	await process_frame
+
