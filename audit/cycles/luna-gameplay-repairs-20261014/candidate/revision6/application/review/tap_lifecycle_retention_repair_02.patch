+func _route_voice_is_playing(host: ReefMain, key: String) -> bool:
+	var exact := host._audio_ref()._voice_path("roshan", key, false)
+	if exact.is_empty():
+		return false
+	for item: Variant in host.voice_pool:
+		var player := item as AudioStreamPlayer
+		if player != null and player.playing and player.stream != null and player.stream.resource_path == exact:
+			return true
+	return false
+
