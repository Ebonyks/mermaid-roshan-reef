+func _fixture_snapshots_equal(actual: Dictionary, expected: Dictionary) -> bool:
+	# The receipt is JSON: its arrays are untyped and its numbers are floats.
+	# Compare both snapshots in that same domain, preserving keys, order,
+	# booleans, strings and full-precision numeric values. These earned probe
+	# counters/masks stay below JSON's exact-integer limit.
+	if not _fixture_json_safe(actual) or not _fixture_json_safe(expected):
+		return false
+	var actual_json: Variant = JSON.parse_string(JSON.stringify(actual, "", true, true))
+	var expected_json: Variant = JSON.parse_string(JSON.stringify(expected, "", true, true))
+	return actual_json is Dictionary and expected_json is Dictionary and actual_json == expected_json
+
+
+func _fixture_json_safe(value: Variant, depth: int = 0) -> bool:
+	if depth > 32:
+		return false
+	match typeof(value):
+		TYPE_NIL, TYPE_BOOL, TYPE_STRING:
+			return true
+		TYPE_INT:
+			return value >= -9007199254740991 and value <= 9007199254740991
+		TYPE_FLOAT:
+			var number := float(value)
+			return is_finite(number) and number >= -9007199254740991.0 and number <= 9007199254740991.0
+		TYPE_ARRAY:
+			for item: Variant in value as Array:
+				if not _fixture_json_safe(item, depth + 1):
+					return false
+			return true
+		TYPE_DICTIONARY:
+			var dictionary := value as Dictionary
+			for key: Variant in dictionary:
+				if not key is String or not _fixture_json_safe(dictionary[key], depth + 1):
+					return false
+			return true
+	return false
+
+
+func _audit_fixture_snapshot_comparison() -> void:
+	var masks: Array[int] = [7, 0, 0, 0, 0, 0, 0, 0]
+	var native := {"masks": masks, "done": false, "objective": "party_prep", "count": 19}
+	var from_json: Dictionary = JSON.parse_string(JSON.stringify(native)) as Dictionary
+	_check("fixture snapshot comparison accepts the exact JSON serialization boundary",
+		_fixture_snapshots_equal(native, from_json))
+	var changed := from_json.duplicate(true)
+	var changed_masks := changed["masks"] as Array
+	changed_masks[0] = 3
+	var reordered := from_json.duplicate(true)
+	var reordered_masks := reordered["masks"] as Array
+	reordered_masks.reverse()
+	var missing := from_json.duplicate(true)
+	missing.erase("done")
+	var extra := from_json.duplicate(true)
+	extra["unexpected"] = false
+	var wrong_bool := from_json.duplicate(true)
+	wrong_bool["done"] = 0
+	var wrong_text := from_json.duplicate(true)
+	wrong_text["objective"] = "story_complete"
+	var fraction := from_json.duplicate(true)
+	fraction["count"] = 19.5
+	_check("fixture snapshot comparison rejects changed masks, order, keys, booleans, strings and numbers",
+		not _fixture_snapshots_equal(native, changed) and not _fixture_snapshots_equal(native, reordered)
+		and not _fixture_snapshots_equal(native, missing) and not _fixture_snapshots_equal(native, extra)
+		and not _fixture_snapshots_equal(native, wrong_bool) and not _fixture_snapshots_equal(native, wrong_text)
+		and not _fixture_snapshots_equal(native, fraction))
+	var unsafe := {"count": 9007199254740992}
+	var nonfinite := {"count": INF}
+	var unsupported := {"value": Vector2.ZERO}
+	_check("fixture snapshot comparison rejects unsafe integers, nonfinite values and unsupported types",
+		not _fixture_snapshots_equal(unsafe, unsafe)
+		and not _fixture_snapshots_equal(nonfinite, nonfinite)
+		and not _fixture_snapshots_equal(unsupported, unsupported))
+
