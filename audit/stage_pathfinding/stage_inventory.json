  "rules": {
    "tap_or_drag_activation": "A tap on a visible door/object or a drag toward it requests travel; action fires only after Roshan reaches the target approach point.",
    "approach_before_action": "Every object action has an explicit approach_point and arrival_radius; tapping from across the room never performs the action remotely.",
    "door_arrival": "A door/portal activates on tap or drag, then transitions only after arrival; cancellation and return restore the launching stage.",
    "oob": "Clamp or recover to the nearest authored walk lane, clear velocity, preserve progress, and provide a voiced/picture pointer; no fail state or lost save.",
    "fixed_surface_seam": "Fixed minigames may own the board interaction, but entry must be reached through the source stage and exit must return to its exact source room/coordinate."
  },
