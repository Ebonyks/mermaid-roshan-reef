# Godot 4+ — editor import cache & generated data (regenerated on first open)
.godot/

# Godot exports / builds
/build/
/export/
*.tmp
/roshan-reef.apk

# Godot 4 editor sidecars. Historical tracked sidecars remain tracked, but new
# assets and scripts must not add machine-generated import/UID churn.
*.import
*.uid
/assets/characters/roshan_v4_Image_*.jpg

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
*.swp

# staged asset downloads (tools/fetch_assets.sh)
assets/_staging/
__pycache__/

# Generated audit outputs stay local; expose only the governed audit sources.
/audit/*
!/audit/MASTER_AUDIT_2026-08-09.md
!/audit/MASTER_AUDIT_CHANGELOG_ROLLBACK_2026-08-10.md
# QA contact sheet regenerated by tools/audit_fairy_art_v2.py on every gate run
/tmp/fairy_v2/

# Local probe profiles, captures, and review builds are non-production
# evidence. Existing tracked fixtures under tmp/ remain tracked normally.
/tmp/*

# local API keys — never committed
.secrets/

# Kokoro TTS model + voice packs (downloaded per make_voices.py setup docs)
tools/kokoro/
*.blend1

# Repository-local FFmpeg installed by tools/setup_video_tools.ps1
/.video-tools/

# git-worktree checkouts must never be committed as phantom gitlinks
# (a tracked .worktrees/ entry with no .gitmodules URL breaks actions/checkout)
.worktrees/
