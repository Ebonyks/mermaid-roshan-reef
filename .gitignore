# Godot 4+ — editor import cache & generated data (regenerated on first open)
.godot/

# Godot exports / builds
/build/
/export/
*.tmp
/roshan-reef.apk

# Godot 4 editor sidecars. Historical tracked sidecars remain tracked, but new
# assets and scripts must not add machine-generated import/UID churn.
*.import
*.uid
/assets/characters/roshan_v4_Image_*.jpg

# OS / editor cruft
Thumbs.db
desktop.ini
.DS_Store
*.swp

# staged asset downloads (tools/fetch_assets.sh)
assets/_staging/
__pycache__/

# Local non-destructive rig/mesh diagnostic output
/audit/

# local API keys — never committed
.secrets/

# Kokoro TTS model + voice packs (downloaded per make_voices.py setup docs)
tools/kokoro/

# Per-frame turntable renders from tools/build_npc_draft.py --preview.
# Reviewable contact sheets are committed to art_library/character_drafts_*/.
/tools/out/npc_draft/

# Regenerated on every gate run by tools/audit_fairy_art_v2.py (ci.sh step).
/tmp/fairy_v2/
