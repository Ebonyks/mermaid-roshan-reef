  "findings": [
    {
      "priority": "P1",
      "family": "Foreground foliage / rear hedges",
      "finding": "Smooth rounded foreground clumps have pale highlights and lower saturation than the fine, dappled rear hedge. Large pointed foreground leaves are darker. A universal foreground brightness or saturation adjustment would push one family further out of balance.",
      "action": "Match leaf shape and painted highlight width first; then grade only the offending leaf material. Preserve the purple berries and intentional front-to-back contrast.",
      "decision": "Color-only clump trial not selected; one pointed-leaf replacement has entered eight-cel contextual review, not runtime acceptance."
    },
    {
      "priority": "P1",
      "family": "Night foliage",
      "finding": "Large foreground leaves lose internal shadow detail at night. This is a value-range and ambient-tint problem, not a reason to brighten every leaf or change the whole night palette.",
      "action": "Test a restrained leaf-shadow lift against its adjoining hedge in all three views. Keep roots and gaps dark enough to read depth.",
      "decision": "Existing night-only leaf lift was too localized to resolve the scene; not selected."
    },
    {
      "priority": "P1",
      "family": "Lawn and animated grass",
      "finding": "Yellow-green lawn marks remain much brighter than many foreground leaf masses, and sparse bright moving flecks do not describe coherent whole grass.",
      "action": "Anchor grass colors to its own lawn patch, animate complete connected tufts and preserve quieter grass around paths. Review root shade and blade highlights across every cel.",
      "decision": "One accent tuft is implemented; broad ground-cover motion and cross-screen lawn coherence remain open."
    },
    {
      "priority": "P2",
      "family": "Flowers and berries",
      "finding": "Cream/yellow flowers are strong local accents, especially beside the castle. Purple berry identity is useful, but repeated pale clusters draw a visual rhythm unrelated to the planting groups.",
      "action": "Keep cream, pink and purple distinct. Limit repeated pale clusters and align each flower group with a plausible supporting plant; no global desaturation.",
      "decision": "Needs grouped planting review and whole-cel comparisons."
    },
    {
      "priority": "P2",
      "family": "Sky, high clouds, cloud sea and mountains",
      "finding": "Cool distance colors support depth. Some high cloud cards have broader purple shadow lobes than the fine cloud sea. Equalizing their contrast would flatten the panorama.",
      "action": "Compare cloud shadow hue and edge softness at drift extremes while retaining lower contrast in the distant banks.",
      "decision": "Twelve cloud cards now have multiple cels; the low cloud sea remains an unintegrated motion study."
    },
    {
      "priority": "P2",
      "family": "Water and shore stones",
      "finding": "Cyan water reads clearly against lavender/grey shore stones. Darker water gives the bridge a useful boundary; bright ripple highlights need event-state review.",
      "action": "Preserve shore continuity; audit ripple onset/peak/fade and water cels for hue or luminance pumping, separately from fixed shoreline samples.",
      "decision": "These six stills do not establish all water interaction states."
    },
    {
      "priority": "P2",
      "family": "Paths, left castle approach and bridge",
      "finding": "Lavender main paths and the pale warm bridge remain distinguishable in these views. The left uphill approach is deliberately less prominent, but must remain discoverable.",
      "action": "Protect the route palette and path clearances during plant edits; inspect bridge flex/contact poses and path edges at all camera positions.",
      "decision": "No route recoloring proposed from these samples alone."
    },
    {
      "priority": "P2",
      "family": "Castle walls, roofs, gold and windows",
      "finding": "Purple architecture and warm trim form a coherent focal point. Night ambient tint dims windows and reflective accents with opaque surfaces; those materials need independent treatment.",
      "action": "Separate modest warm window/glint accents from wall ambient grade; avoid restoring day-bright walls. Keep the four towers and protected portrait intact.",
      "decision": "Night emission and entry hierarchy remain open."
    },
    {
      "priority": "P2",
      "family": "Playground, tree and props",
