{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "roshan.canvas.binding.v1",
  "type": "object",
  "required": [
    "contract_id",
    "contract_version",
    "view",
    "skin",
    "prop"
  ],
  "properties": {
    "contract_id": {
      "const": "roshan.canvas.shared"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "view": {
      "enum": [
        "front",
        "quarter_right",
        "profile_right",
        "quarter_left"
      ]
    },
    "skin": {
      "type": "string",
      "minLength": 1
    },
    "prop": {
      "type": "object",
      "required": [
        "path",
        "native_size",
        "grips",
        "orientation",
        "support_point_px",
        "occlusion"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "grips": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "socket",
              "prop_px"
            ],
            "properties": {
              "socket": {
                "enum": [
                  "grip.screen_left",
                  "grip.screen_right"
                ]
              },
              "prop_px": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
