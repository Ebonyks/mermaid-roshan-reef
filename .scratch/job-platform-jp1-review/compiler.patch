+    if len(matches) != 1:
+        raise ValueError("expected exactly one real SaveState function " + name)
+    start = matches[0]
+    end = re.search(r"(?m)^(?:static\s+)?func\b", code[start.end():])
+    return text[start.end():start.end() + end.start() if end else len(text)]
